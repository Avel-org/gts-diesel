{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/emergency-roadside-repair",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/computer-diagnostics",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/general-truck-repair",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/trailer-repair",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/fleet-services",
      "destination": "/#fleet",
      "statusCode": 301
    },
    {
      "source": "/service-area",
      "destination": "/#area",
      "statusCode": 301
    },
    {
      "source": "/referral",
      "destination": "/#why",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/#quote",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
